{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "patagonia-wings-web51-qa",
  "main": "scripts/cloudflare/worker.mjs",
  "compatibility_date": "2026-10-16",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "patagonia-wings-web51-qa"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "redact_query_string": true
  },
  "vars": {
    "VECTOR_HOSTING_PLATFORM": "cloudflare",
    "VECTOR_DEPLOYMENT_STAGE": "preview",
    "VECTOR_SITE_MODE": "preview",
    "VECTOR_FORMS_ENABLED": "true",
    "VECTOR_FORMS_MODE": "preview",
    "SUPABASE_URL": "https://donguccheqjqyzudowuy.supabase.co",
    "VECTOR_QA_FORMS_ONLY": "true",
    "VECTOR_QA_FORM_EMAIL": "qa-web52-20261016-a4f2@example.test",
    "VECTOR_COMMUNITY_AUTH_ENABLED": "true",
    "VECTOR_COMMUNITY_REGISTRATION_ENABLED": "false",
    "VECTOR_COMMUNITY_QA_REGISTRATION_ENABLED": "false",
    "VECTOR_COMMUNITY_QA_GUARD_READY": "true",
    "VECTOR_MAIL_ENABLED": "false",
    "VECTOR_QA_SMTP_TEST_APPROVED": "false",
    "VECTOR_MAIL_MODE": "preview",
    "VECTOR_SMTP_HOST": "smtp.us.appsuite.cloud",
    "VECTOR_SMTP_PORT": "465",
    "VECTOR_SMTP_USER": "patagonia@patagoniaw.com",
    "VECTOR_MAIL_FROM": "patagonia@patagoniaw.com",
    "VECTOR_MAIL_INTERNAL_TO": "patagonia@patagoniaw.com",
    "VECTOR_MAIL_PREVIEW_RECIPIENTS": "patagonia@patagoniaw.com",
    "VECTOR_MAIL_PUBLIC_ORIGIN": "https://patagonia-wings-web51-qa.lizamaclaudio.workers.dev",
    "VECTOR_COMMUNITY_QA_INVITE_EXPIRES": "2026-10-16T22:59:51.825Z",
